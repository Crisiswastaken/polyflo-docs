      "tab": "Guides",
      "groups": [
        {
          "group": "Using Polyflo",
          "icon": "message",
          "pages": ["troubleshooting", "compare"]
        },
        {
          "group": "Developers",
          "icon": "code-simple",
          "pages": ["build-from-source"]
        }
      ]
    },
