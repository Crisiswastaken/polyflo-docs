{
  "theme": "sharp",
  "appearance": {
    "contentIcons": "accent"
  },
  "markdown": {
    "enabled": true
  },
  "fonts": {
    "body": { "family": "Albert Sans", "weight": ["400", "500", "600", "700"] },
    "heading": { "family": "Unbounded", "weight": ["500", "600", "700"] }
  },
  "i18n": {
    "defaultLocale": "en",
    "locales": [
      {
        "code": "en",
        "label": "English"
      }
    ]
  },
  "navbar": {
