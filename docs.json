        {
          "group": "Internals",
          "icon": "code-simple",
          "pages": [
            "architecture",
            "session",
            "audio",
            "speech-to-text",
            "injection",
            "frontend",
            "ipc",
            "data-and-secrets"
          ]
        },
        {
          "group": "Ship your own",
          "icon": "box",
          "pages": ["forking", "adding-features", "testing", "releases"]
        }
      ]
    },
    {
      "tab": "Changelog",
      "href": "/changelog"
    }
  ],
  "ai": {
    "chat": true,
    "label": "Ask Polyflo",
    "systemPrompt": "Answer from Polyflo documentation. Polyflo is an open-source desktop push-to-talk dictation app (Tauri v2 + Rust + React) for Windows and macOS that uses a Sarvam API key and HTTP Saaras v3 STT — not WebSocket. For install and daily use, prefer Get started. For contributors and forks, prefer Contribute: repository layout, session lifecycle, audio, STT, injection, IPC allow-lists, testing, and releases. Cite page URLs."
  },
  "tracking": {
    "repos": [
      {
        "owner": "Crisiswastaken",
        "repo": "PolyFlo",
        "branch": "main",
        "outputTab": "Guides",
        "outputGroup": "Using Polyflo"
      }
    ]
  }
}
