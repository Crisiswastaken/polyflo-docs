      {
        "label": "GitHub",
        "href": "https://github.com/Crisiswastaken/PolyFlo",
        "type": "github"
      }
    ],
    "primary": {
      "label": "Install Polyflo",
      "href": "/quickstart"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Crisiswastaken/PolyFlo"
    },
    "links": [
      {
        "heading": "Product",
        "items": [
          { "label": "Overview", "href": "/" },
          { "label": "Install", "href": "/quickstart" },
          { "label": "Dictation", "href": "/dictation" },
          { "label": "Changelog", "href": "/changelog" }
        ]
      },
      {
        "heading": "Setup",
        "items": [
          { "label": "API key", "href": "/api-key" },
          { "label": "Settings", "href": "/settings" },
          { "label": "Languages", "href": "/languages" },
          { "label": "Troubleshooting", "href": "/troubleshooting" }
        ]
      },
      {
        "heading": "Developers",
        "items": [
          { "label": "Build from source", "href": "/build-from-source" },
          { "label": "Architecture", "href": "/architecture" },
          { "label": "GitHub", "href": "https://github.com/Crisiswastaken/PolyFlo" },
          { "label": "Releases", "href": "https://github.com/Crisiswastaken/PolyFlo/releases" }
        ]
      }
    ]
  },
  "tabs": [
    {
      "tab": "Get started",
      "groups": [
        {
          "group": "Start here",
          "icon": "book-open",
          "pages": ["introduction", "quickstart", "dictation"]
        },
        {
          "group": "Set up",
          "icon": "wrench",
          "pages": ["api-key", "settings", "languages"]
        }
      ]
    },
    {
      "tab": "Guides",
      "groups": [
        {
          "group": "Using Polyflo",
          "icon": "message",
          "pages": ["troubleshooting", "compare"]
        },
        {
          "group": "Developers",
          "icon": "code-simple",
          "pages": ["build-from-source", "architecture"]
        }
      ]
    },
    {
      "tab": "Changelog",
      "href": "/changelog"
    }
  ],
  "ai": {
    "chat": true,
    "label": "Ask Polyflo",
    "systemPrompt": "Answer from Polyflo documentation. Polyflo is a desktop push-to-talk dictation app for Windows and macOS that uses a Sarvam API key. Prefer concise answers with links to the matching guide."
  },
  "tracking": {
    "repos": [
      {
        "owner": "Crisiswastaken",
        "repo": "PolyFlo",
        "branch": "main",
        "outputTab": "Guides",
        "outputGroup": "Using Polyflo"
      }
    ]
  }
